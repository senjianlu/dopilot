#!/bin/sh
# pre-commit 钩子:公开仓库脱敏检查,扫描暂存内容与路径(零依赖 POSIX sh + python3)。
# 启用: git config core.hooksPath .githooks
# 规则: docs/decisions/0024-public-repo-redaction.md
# 私有规则文件缺失时 fail-closed;外部贡献者可设 DOPILOT_REDACTION_RULES=none
# 只跑入库的通用规则。
root=$(git rev-parse --show-toplevel) || exit 1
if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: 脱敏检查需要 python3(docs/decisions/0024)" >&2
  exit 1
fi
exec python3 "$root/scripts/redaction/redact.py" check --staged
