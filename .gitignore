# rawf:运行时状态不入库(产物入库,状态不入库)
.ai/.current-task
# rawf:评审异常时遗留的原始输出与原子发布临时文件
.ai/**/.review-raw-*
.ai/**/.review-out-*
# rawf:plan 阶段评审的原始输出与原子发布临时文件
.ai/**/.plan-review-raw-*
.ai/**/.plan-review-out-*
# Claude Code 本地权限记录等,不入库(项目级 settings.json 入库)
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/
dist/
build/
*.egg-info/

# Node / web
node_modules/
apps/web/dist/
apps/web/node_modules/
# web TS build artifacts (incremental build cache; emit is disabled via noEmit)
*.tsbuildinfo
# Playwright browser e2e outputs (traces/screenshots/videos + HTML report)
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
apps/web/.cache/

# local config copies (examples are committed as configs/*.example.toml)
configs/server.toml
configs/agent.toml
# local server/agent data (log bodies live here, see docs/decisions)
server-data/
agent-data/

# IDE / 系统
.idea
.vscode/
.DS_Store

# 环境
.env
.env.*
