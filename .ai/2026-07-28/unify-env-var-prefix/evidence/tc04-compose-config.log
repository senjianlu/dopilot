        migrate:
          condition: service_completed_successfully
          required: true
        redis:
          condition: service_healthy
          required: true
        scrapy-agent-1:
          condition: service_healthy
          required: true
        scrapy-agent-2:
          condition: service_healthy
          required: true
        scrapy-agent-3:
          condition: service_healthy
          required: true
      environment:
