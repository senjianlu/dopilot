docker compose 版本:Docker Compose version v5.1.4

===== docker-compose.yml =====
  name: docker
  services:
    db:
      environment:
        POSTGRES_DB: dopilot
        POSTGRES_PASSWORD: dopilot
        POSTGRES_USER: dopilot
      healthcheck:
        test:
          - CMD-SHELL
          - pg_isready -U dopilot -d dopilot
        timeout: 5s
        interval: 5s
        retries: 10
      image: postgres:16
      logging:
        driver: json-file
        options:
          max-file: "3"
          max-size: 10m
      networks:
        default: null
      ports:
        - mode: ingress
          target: 5432
          published: "5432"
          protocol: tcp
      restart: unless-stopped
      volumes:
        - type: volume
          source: dopilot-db
          target: /var/lib/postgresql/data
          volume: {}
    migrate:
      command:
        - alembic
        - upgrade
        - head
      depends_on:
        db:
          condition: service_healthy
          required: true
      environment:
        DOPILOT_DATABASE_URL: postgresql+psycopg://dopilot:dopilot@db:5432/dopilot
      image: rabbir/dopilot:latest
      logging:
        driver: json-file
        options:
          max-file: "3"
          max-size: 10m
      networks:
        default: null
      restart: "no"
    redis:
      command:
        - redis-server
        - --appendonly
        - "yes"
        - --requirepass
        - tc04-pass
        - --maxmemory
        - 512mb
        - --maxmemory-policy
        - noeviction
        - --auto-aof-rewrite-percentage
        - "100"
        - --auto-aof-rewrite-min-size
        - 64mb
      healthcheck:
        test:
          - CMD
          - redis-cli
          - --no-auth-warning
          - -a
          - tc04-pass
          - ping
        timeout: 5s
        interval: 5s
        retries: 20
      image: redis:7
      logging:
        driver: json-file
        options:
          max-file: "3"
          max-size: 10m
      networks:
        default: null
      restart: unless-stopped
      volumes:
        - type: volume
          source: dopilot-redis
          target: /data
          volume: {}
    scrapy-agent-1:
      command:
        - dopilot-agent
      depends_on:
        redis:
          condition: service_healthy
          required: true
      environment:
        DOPILOT_AGENT_ID: scrapy-agent-1
        DOPILOT_AGENT_TOKEN: change-me-agent-token
        DOPILOT_AGENT_WORKDIR: /agent-data
        DOPILOT_REDIS_URL: redis://:tc04-pass@redis:6379/0
      healthcheck:
        test:
          - CMD
          - dopilot-agent-healthcheck
        timeout: 5s
        interval: 5s
        retries: 20
        start_period: 30s
      image: rabbir/dopilot:latest
      init: true
      logging:
        driver: json-file
        options:
          max-file: "3"
          max-size: 10m
      networks:
        default: null
      restart: unless-stopped
      volumes:
        - type: volume
          source: dopilot-agent1-data
          target: /agent-data
          volume: {}
    scrapy-agent-2:
      command:
        - dopilot-agent
      depends_on:
        redis:
          condition: service_healthy
          required: true
      environment:
        DOPILOT_AGENT_ID: scrapy-agent-2
        DOPILOT_AGENT_TOKEN: change-me-agent-token
        DOPILOT_AGENT_WORKDIR: /agent-data
        DOPILOT_REDIS_URL: redis://:tc04-pass@redis:6379/0
      healthcheck:
        test:
          - CMD
          - dopilot-agent-healthcheck
        timeout: 5s
        interval: 5s
        retries: 20
        start_period: 30s
      image: rabbir/dopilot:latest
      init: true
      logging:
        driver: json-file
        options:
          max-file: "3"
          max-size: 10m
      networks:
        default: null
      restart: unless-stopped
      volumes:
        - type: volume
          source: dopilot-agent2-data
          target: /agent-data
          volume: {}
    scrapy-agent-3:
      command:
        - dopilot-agent
      depends_on:
        redis:
          condition: service_healthy
          required: true
      environment:
        DOPILOT_AGENT_ID: scrapy-agent-3
        DOPILOT_AGENT_TOKEN: change-me-agent-token
        DOPILOT_AGENT_WORKDIR: /agent-data
        DOPILOT_REDIS_URL: redis://:tc04-pass@redis:6379/0
      healthcheck:
        test:
          - CMD
          - dopilot-agent-healthcheck
        timeout: 5s
        interval: 5s
        retries: 20
